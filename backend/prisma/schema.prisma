generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  username String
  email String @unique
  password String
  todos Todo[]

}

model Todo {
  id String @id @default(uuid())
  title String
  description String?
  status Status @default(INCOMPLETED)

  userId String
  user User @relation(fields: [userId], references: [id])
}

enum Status {
  COMPLETED 
  INCOMPLETED
  DELETED
}